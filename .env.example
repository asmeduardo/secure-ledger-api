# Local development only. Copy to .env (ignored by Git). The values below are placeholders for a
# disposable environment on your own machine; never reuse them anywhere else.

# PostgreSQL started by compose.yaml (host port published on 127.0.0.1).
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=local-dev-only-postgres
POSTGRES_PORT=5432

# Client secrets of the local authorization server (dev-auth-server).
SECURE_LEDGER_WALLET_CLIENT_SECRET=local-dev-only-wallet
SECURE_LEDGER_MARKETPLACE_CLIENT_SECRET=local-dev-only-marketplace
SECURE_LEDGER_AUDITOR_CLIENT_SECRET=local-dev-only-auditor

# Host port of the API container.
LEDGER_API_PORT=8080
